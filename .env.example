# Supply BOTH values to select a segregated staging project. Never put service_role here.
VITE_APP_ENV=staging
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-STAGING-PUBLISHABLE-KEY

# Optional Staff catalog: use a segregated endpoint before enabling this feature.
# VITE_STAFF_API_URL=https://YOUR-SANDBOX/functions/v1/staff-api
